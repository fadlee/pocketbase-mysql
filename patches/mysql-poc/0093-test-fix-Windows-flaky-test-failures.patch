From 963afeaad5f11be5427f8dce64a6a76b7231a5ed Mon Sep 17 00:00:00 2001
From: fadlee <fad.lee@hotmail.com>
Date: Mon, 29 Jun 2026 15:01:22 +0700
Subject: [PATCH 93/95] test: fix Windows flaky test failures

- TestIntrospectionDialectMySQL: fix assertion to expect backtick-quoted
  \sql\ reserved keyword in ViewsQuery
- TestOTPHasExpired/TestMFAHasExpired: add 1ms buffer to created timestamp
  to avoid Windows clock resolution boundary condition at exactly 5min
- TestAutodateRecordResave: add 20ms sleep between saves to ensure clock
  tick on Windows (~15ms resolution)
- tools/archive symlink tests: skip symlink creation when platform lacks
  privilege (Windows non-admin), adjust expected zip size accordingly
---
 core/db_dialect_test.go      | 4 +---
 core/field_autodate_test.go  | 4 ++++
 core/mfa_model_test.go       | 2 +-
 core/otp_model_test.go       | 2 +-
 tools/archive/create_test.go | 8 ++++++--
 5 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/core/db_dialect_test.go b/core/db_dialect_test.go
index b042809e..68ce5d07 100644
--- a/core/db_dialect_test.go
+++ b/core/db_dialect_test.go
@@ -106,9 +106,7 @@ func TestIntrospectionDialectMySQL(t *testing.T) {
 				AND LOWER(TABLE_NAME) = LOWER({:tableName})
 			LIMIT 1`, d.HasTableQuery())
 
-	require.Equal(t, `SELECT TABLE_NAME AS name, VIEW_DEFINITION AS sql
-			FROM information_schema.VIEWS
-			WHERE TABLE_SCHEMA = DATABASE()`, d.ViewsQuery())
+	require.Equal(t, "SELECT TABLE_NAME AS name, VIEW_DEFINITION AS `sql` FROM information_schema.VIEWS WHERE TABLE_SCHEMA = DATABASE()", d.ViewsQuery())
 
 	require.Equal(t, `SELECT TABLE_NAME
 			FROM information_schema.STATISTICS
diff --git a/core/field_autodate_test.go b/core/field_autodate_test.go
index 8861ae6e..7ba34eb0 100644
--- a/core/field_autodate_test.go
+++ b/core/field_autodate_test.go
@@ -367,6 +367,7 @@ func TestAutodateRecordResave(t *testing.T) {
 	lastUpdated := record.GetDateTime("updated")
 
 	// save with autogenerated date
+	time.Sleep(20 * time.Millisecond) // ensure clock tick on Windows (~15ms resolution)
 	err = app.Save(record)
 	if err != nil {
 		t.Fatal(err)
@@ -393,6 +394,7 @@ func TestAutodateRecordResave(t *testing.T) {
 	lastUpdated = newUpdated
 
 	// save again with autogenerated date
+	time.Sleep(20 * time.Millisecond) // ensure clock tick on Windows (~15ms resolution)
 	err = app.Save(record)
 	if err != nil {
 		t.Fatal(err)
@@ -414,6 +416,7 @@ func TestAutodateRecordResave(t *testing.T) {
 	})
 
 	// save again with autogenerated date (should fail)
+	time.Sleep(20 * time.Millisecond) // ensure clock tick on Windows (~15ms resolution)
 	err = app.Save(record)
 	if err == nil {
 		t.Fatal("Expected save failure")
@@ -429,6 +432,7 @@ func TestAutodateRecordResave(t *testing.T) {
 	// cleanup the error and resave again
 	app.OnRecordUpdateExecute(collection.Id).Unbind("test_failure")
 
+	time.Sleep(20 * time.Millisecond) // ensure clock tick on Windows (~15ms resolution)
 	err = app.Save(record)
 	if err != nil {
 		t.Fatal(err)
