From ef36750de3543475d40d024b0086e9fd7c80f61d Mon Sep 17 00:00:00 2001
From: fadlee <fad.lee@hotmail.com>
Date: Tue, 19 May 2026 20:24:19 +0700
Subject: [PATCH 29/35] Add git ignore and line ending rules

---
 .gitattributes |  8 ++++++++
 .gitignore     | 10 ++++++++++
 2 files changed, 18 insertions(+)
 create mode 100644 .gitattributes

diff --git a/.gitattributes b/.gitattributes
new file mode 100644
index 00000000..ef2208a5
--- /dev/null
+++ b/.gitattributes
@@ -0,0 +1,8 @@
+* text=auto
+*.js text eol=lf
+*.css text eol=lf
+*.html text eol=lf
+*.json text eol=lf
+*.md text eol=lf
+*.yml text eol=lf
+*.yaml text eol=lf
diff --git a/.gitignore b/.gitignore
index 9b99d92f..d0517f40 100644
--- a/.gitignore
+++ b/.gitignore
@@ -18,3 +18,13 @@ CHANGELOG.html
 CHANGELOG_16_22.html
 CHANGELOG_8_15.html
 LICENSE.html
+
+# local runtime artifacts
+/.agents/
+/pb_data/
+/pb-mysql.log
+/pb-server.log
+/pocketbase-mysql
+/pocketbase-mysql.exe
+/pocketbase-mysql~
+/skills-lock.json
-- 
2.54.0.windows.1

