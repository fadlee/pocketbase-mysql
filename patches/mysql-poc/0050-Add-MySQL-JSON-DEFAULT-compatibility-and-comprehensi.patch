 scripts/mysql-runtime-qa.mjs | 487 +++++++++++++++++++++++++++++++++--
 2 files changed, 466 insertions(+), 28 deletions(-)

diff --git a/core/field_geo_point.go b/core/field_geo_point.go
index 542abe85..a38d8957 100644
