From fc0211df83e8edcaa15dcc00e580bf55185e62a7 Mon Sep 17 00:00:00 2001
From: fadlee <fad.lee@hotmail.com>
Date: Sun, 10 May 2026 05:16:28 +0700
Subject: [PATCH 23/93] add tagged binary release workflow

---
 .../workflows/release-pocketbase-mysql.yaml   | 64 +++++++++++++++++++
 1 file changed, 64 insertions(+)
 create mode 100644 .github/workflows/release-pocketbase-mysql.yaml

diff --git a/.github/workflows/release-pocketbase-mysql.yaml b/.github/workflows/release-pocketbase-mysql.yaml
new file mode 100644
index 00000000..d90f8c7a
--- /dev/null
+++ b/.github/workflows/release-pocketbase-mysql.yaml
@@ -0,0 +1,64 @@
+name: release-pocketbase-mysql
+
+on:
+  push:
+    tags:
+      - 'v*'
+
+permissions:
+  contents: write
+
+jobs:
+  build-release:
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - os: ubuntu-latest
+            goos: linux
+            goarch: amd64
+            binary_suffix: ''
+          - os: ubuntu-latest
+            goos: linux
+            goarch: arm64
+            binary_suffix: ''
+          - os: macos-latest
+            goos: darwin
+            goarch: amd64
+            binary_suffix: ''
+          - os: macos-latest
+            goos: darwin
+            goarch: arm64
+            binary_suffix: ''
+          - os: windows-latest
+            goos: windows
+            goarch: amd64
+            binary_suffix: '.exe'
+    runs-on: ${{ matrix.os }}
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+
+      - name: Set up Go
+        uses: actions/setup-go@v6
+        with:
+          go-version: '1.25.0'
+
+      - name: Build pocketbase-mysql
+        env:
+          CGO_ENABLED: 0
+          GOOS: ${{ matrix.goos }}
+          GOARCH: ${{ matrix.goarch }}
+        run: go build -o pocketbase-mysql${{ matrix.binary_suffix }} ./examples/base
+
+      - name: Package release asset
+        shell: bash
+        run: |
+          asset_name="pocketbase-mysql-${{ matrix.goos }}-${{ matrix.goarch }}${{ matrix.binary_suffix }}"
+          mv "pocketbase-mysql${{ matrix.binary_suffix }}" "$asset_name"
+          echo "ASSET_NAME=$asset_name" >> "$GITHUB_ENV"
+
+      - name: Upload release asset
+        uses: softprops/action-gh-release@v2
+        with:
+          files: ${{ env.ASSET_NAME }}
-- 
