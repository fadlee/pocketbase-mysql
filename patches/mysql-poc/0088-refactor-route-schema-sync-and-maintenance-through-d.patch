+			CASE
+				WHEN COALESCE([[%s]], '') = ''
+				THEN JSON_ARRAY()
+				ELSE (
+					CASE
+						WHEN JSON_VALID([[%s]]) AND JSON_TYPE([[%s]]) = 'ARRAY'
+						THEN [[%s]]
