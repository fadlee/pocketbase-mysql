++++++++++++      { cwd: REPO_ROOT, env: this.mysqlEnv(), stdio: ["ignore", logFd, logFd] }
++++++++++++    );
++++++++++++    closeSync(logFd);
++++++++++++
++++++++++++    for (let i = 0; i < 90; i++) {
