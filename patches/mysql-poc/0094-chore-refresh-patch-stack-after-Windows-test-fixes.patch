++++++++++++  mysqlDsn() {
++++++++++++    const creds = this.opts.mysqlPassword
++++++++++++      ? `${this.opts.mysqlUser}:${this.opts.mysqlPassword}`
++++++++++++      : this.opts.mysqlUser;
++++++++++++    return `${creds}@tcp(${this.opts.mysqlHost}:${this.opts.mysqlPort})/${this.opts.mysqlDatabase}?parseTime=true&multiStatements=true`;
++++++++++++  }
++++++++++++
++++++++++++  mysqlEnv() {
++++++++++++    return {
++++++++++++      ...process.env,
